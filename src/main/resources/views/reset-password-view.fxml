<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="560" prefWidth="900"
           styleClass="auth-root"
           stylesheets="@../styles/app.css"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.ResetPasswordController">
    <VBox alignment="CENTER" maxWidth="560" spacing="14" styleClass="auth-card">
        <padding><Insets bottom="30" left="25" right="25" top="30"/></padding>
        <Label text="%auth.resetPassword">
            <font><Font size="30"/></font>
        </Label>
        <Label wrapText="true" text="%auth.resetSubtitle" styleClass="muted-text"/>
        <TextField fx:id="emailField" maxWidth="420" prefHeight="40" promptText="%candidate.email"/>
        <Button onAction="#handleSendResetCode" prefHeight="42" prefWidth="300" styleClass="primary-button" text="%auth.sendReset"/>
        <Separator maxWidth="420"/>
        <TextField fx:id="tokenField" maxWidth="420" prefHeight="40" promptText="%auth.resetToken"/>
        <HBox maxWidth="420" spacing="6">
            <StackPane HBox.hgrow="ALWAYS">
                <PasswordField fx:id="newPasswordField" prefHeight="40" promptText="%auth.newPassword"/>
                <TextField fx:id="visibleNewPasswordField" prefHeight="40" promptText="%auth.newPassword"/>
            </StackPane>
            <Button onAction="#handleToggleNewPasswordVisibility" prefHeight="40" prefWidth="40" styleClass="icon-button" text="👁"/>
        </HBox>
        <HBox maxWidth="420" spacing="6">
            <StackPane HBox.hgrow="ALWAYS">
                <PasswordField fx:id="confirmPasswordField" prefHeight="40" promptText="%auth.confirmPassword"/>
                <TextField fx:id="visibleConfirmPasswordField" prefHeight="40" promptText="%auth.confirmPassword"/>
            </StackPane>
            <Button onAction="#handleToggleConfirmPasswordVisibility" prefHeight="40" prefWidth="40" styleClass="icon-button" text="👁"/>
        </HBox>
        <Button onAction="#handleChangePassword" prefHeight="42" prefWidth="300" styleClass="primary-button" text="%auth.changePassword"/>
        <Hyperlink onAction="#handleBackToLogin" text="%auth.backLogin"/>
        <Label fx:id="messageLabel" wrapText="true" maxWidth="420" styleClass="success-text"/>
    </VBox>
</StackPane>
