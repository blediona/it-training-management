<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="760" prefWidth="1180"
            styleClass="app-root"
            stylesheets="@../styles/app.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.CertificateController">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" prefHeight="72" spacing="18" styleClass="app-header">
                <padding><Insets left="28" right="28"/></padding>
                <Label text="%certificate.title" styleClass="brand-title">
                    <font><Font size="26"/></font>
                </Label>
                <Label text="%certificate.subtitle" styleClass="brand-subtitle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleOpenDashboard" text="%nav.dashboard" styleClass="nav-button"/>
                <Button onAction="#handleOpenTrainings" text="%nav.trainings" styleClass="nav-button"/>
                <Button onAction="#handleOpenPayments" text="%nav.payments" styleClass="nav-button"/>
                <Button onAction="#handleOpenCertificates" text="%nav.certificates" styleClass="nav-button-active"/>
                <Button fx:id="staffButton" onAction="#handleOpenStaff" text="%nav.staff" styleClass="nav-button"/>
                <Button onAction="#handleShowHelp" text="%menu.help" styleClass="nav-button"/>
                <MenuButton fx:id="languageMenuButton" text="%menu.language" styleClass="nav-button">
                    <items>
                        <MenuItem onAction="#handleAlbanianLanguage" text="Shqip">
                            <graphic>
                                <ImageView fitHeight="18" fitWidth="26" preserveRatio="true">
                                    <image><Image url="@../images/flags/al.png"/></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                        <MenuItem onAction="#handleEnglishLanguage" text="English">
                            <graphic>
                                <ImageView fitHeight="18" fitWidth="26" preserveRatio="true">
                                    <image><Image url="@../images/flags/gb.png"/></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                        <MenuItem onAction="#handleGermanLanguage" text="Deutsch">
                            <graphic>
                                <ImageView fitHeight="18" fitWidth="26" preserveRatio="true">
                                    <image><Image url="@../images/flags/de.png"/></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
                <Button onAction="#handleLogout" text="%nav.logout" styleClass="nav-button-active"/>
            </HBox>
            <ToolBar styleClass="app-toolbar">
                <Button onAction="#handleToggleCertificateForm" text="%action.toggleSidebar" styleClass="secondary-button"/>
                <Separator/>
                <TextField fx:id="searchField" onAction="#handleSearch" prefWidth="360" promptText="%search.prompt"/>
                <Button onAction="#handleSearch" text="%action.search" styleClass="secondary-button"/>
                <Separator/>
                <Button onAction="#handleDownloadCertificatePdf" text="%certificate.downloadPdf" styleClass="secondary-button"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <HBox spacing="18">
            <padding><Insets bottom="24" left="24" right="24" top="24"/></padding>
            <VBox fx:id="certificateFormPane" prefWidth="340" spacing="14" styleClass="surface">
                <padding><Insets bottom="22" left="22" right="22" top="22"/></padding>
                <Label text="%certificate.issue" styleClass="section-title">
                    <font><Font size="22"/></font>
                </Label>
                <TextField fx:id="candidateIdField" promptText="%certificate.candidateId"/>
                <TextField fx:id="certificateNumberField" promptText="%certificate.number"/>
                <DatePicker fx:id="issuedDatePicker" promptText="%certificate.date"/>
                <TextArea fx:id="notesArea" prefHeight="130" promptText="%certificate.notes"/>
                <Button onAction="#handleGenerateCertificate" prefHeight="42" prefWidth="296" text="%certificate.generate" styleClass="primary-button"/>
            </VBox>

            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <HBox spacing="14">
                    <VBox prefWidth="220" onMouseClicked="#handleShowCertificates" styleClass="metric-card">
                        <Label text="%dashboard.certifiedCandidates" styleClass="metric-label"/>
                        <Label fx:id="certifiedCountLabel" text="0" styleClass="metric-value"/>
                    </VBox>
                    <VBox prefWidth="260" onMouseClicked="#handleShowReadyCandidates" styleClass="metric-card">
                        <Label text="%certificate.ready" styleClass="metric-label"/>
                        <Label fx:id="readyCountLabel" text="0" styleClass="metric-value"/>
                    </VBox>
                </HBox>
                <TableView fx:id="certificatesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="70" text="ID"/>
                        <TableColumn fx:id="candidateIdColumn" prefWidth="150" text="%certificate.candidateId"/>
                        <TableColumn fx:id="certificateNumberColumn" prefWidth="250" text="%certificate.number"/>
                        <TableColumn fx:id="issuedDateColumn" prefWidth="180" text="%certificate.date"/>
                    </columns>
                </TableView>
                <TableView fx:id="readyCandidatesTable" visible="false" managed="false" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="readyIdColumn" prefWidth="70" text="ID"/>
                        <TableColumn fx:id="readyNameColumn" prefWidth="220" text="%candidate.fullName"/>
                        <TableColumn fx:id="readyEmailColumn" prefWidth="260" text="%candidate.email"/>
                        <TableColumn fx:id="readyTrainingColumn" prefWidth="260" text="%candidate.training"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
