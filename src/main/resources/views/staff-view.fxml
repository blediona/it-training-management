<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="760" prefWidth="1180"
            styleClass="app-root"
            stylesheets="@../styles/app.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.StaffController">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" prefHeight="72" spacing="18" styleClass="app-header">
                <padding><Insets left="28" right="28"/></padding>
                <Label text="%staff.title" styleClass="brand-title">
                    <font><Font size="26"/></font>
                </Label>
                <Label text="%staff.subtitle" styleClass="brand-subtitle"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleOpenDashboard" text="%nav.dashboard" styleClass="nav-button"/>
                <Button onAction="#handleOpenTrainings" text="%nav.trainings" styleClass="nav-button"/>
                <Button onAction="#handleOpenPayments" text="%nav.payments" styleClass="nav-button"/>
                <Button onAction="#handleOpenCertificates" text="%nav.certificates" styleClass="nav-button"/>
                <Button onAction="#handleOpenStaff" text="%nav.staff" styleClass="nav-button-active"/>
                <Button onAction="#handleShowHelp" text="%menu.help" styleClass="nav-button"/>
                <MenuButton fx:id="languageMenuButton" text="%menu.language" styleClass="nav-button">
                    <items>
                        <MenuItem onAction="#handleAlbanianLanguage" text="Shqip">
                            <graphic>
                                <ImageView fitHeight="18" fitWidth="26" preserveRatio="true">
                                    <image><Image url="@../images/flags/al.png"/></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                        <MenuItem onAction="#handleEnglishLanguage" text="English">
                            <graphic>
                                <ImageView fitHeight="18" fitWidth="26" preserveRatio="true">
                                    <image><Image url="@../images/flags/gb.png"/></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                        <MenuItem onAction="#handleGermanLanguage" text="Deutsch">
                            <graphic>
                                <ImageView fitHeight="18" fitWidth="26" preserveRatio="true">
                                    <image><Image url="@../images/flags/de.png"/></image>
                                </ImageView>
                            </graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
                <Button onAction="#handleLogout" text="%nav.logout" styleClass="nav-button-active"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="18">
            <padding><Insets bottom="24" left="24" right="24" top="24"/></padding>
            <VBox prefWidth="420" spacing="14" styleClass="surface">
                <padding><Insets bottom="26" left="26" right="26" top="26"/></padding>
                <Label text="%staff.register" styleClass="section-title">
                    <font><Font size="24"/></font>
                </Label>
                <Label text="%staff.accountHint" wrapText="true" styleClass="muted-text"/>
                <VBox spacing="3">
                    <Label fx:id="fullNameErrorLabel" visible="false" managed="false" styleClass="error-text"/>
                    <TextField fx:id="fullNameField" prefHeight="42" promptText="%auth.fullName"/>
                </VBox>
                <TextField fx:id="emailField" prefHeight="42" promptText="%candidate.email"/>
                <Button onAction="#handleRegisterStaff" prefHeight="42" prefWidth="260" text="%staff.register" styleClass="primary-button"/>
                <Label fx:id="messageLabel" wrapText="true" styleClass="success-text"/>
            </VBox>
            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <Label text="%staff.list" styleClass="section-title">
                    <font><Font size="22"/></font>
                </Label>
                <TableView fx:id="staffTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="staffIdColumn" prefWidth="70" text="ID"/>
                        <TableColumn fx:id="staffNameColumn" prefWidth="220" text="%auth.fullName"/>
                        <TableColumn fx:id="staffEmailColumn" prefWidth="280" text="%candidate.email"/>
                        <TableColumn fx:id="staffUsernameColumn" prefWidth="180" text="%auth.username"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
